# Zkopíruj do .env a vyplň skutečné hodnoty. .env se necommituje (viz .gitignore).

# Gemini API klíč pro Nano Banana Pro (gemini-3-pro-image-preview). Lze později přenastavit
# i v UI (Nastavení) — hodnota z DB má přednost před touto proměnnou, viz src/lib/settings.ts.
GEMINI_API_KEY=

# Volitelně přepsat model (výchozí: gemini-3-pro-image-preview).
# GEMINI_MODEL=gemini-3-pro-image-preview

# Heslo pro přihlášení do appky (jednoduchá shared-password autentizace, viz docs/API.md sekce 1).
APP_PASSWORD=

# Náhodný dlouhý řetězec pro podepisování session cookie. Vygeneruj např.:
#   openssl rand -hex 32
APP_SECRET=

# Kolik jobů appka zpracovává souběžně (výchozí 1 — pro jednoho uživatele stačí, viz docs/PRD.md
# sekce 8). Fan-out na 1-4 výstupy uvnitř jednoho jobu probíhá vždy paralelně bez ohledu na toto.
# JOB_CONCURRENCY=1

# Kam appka ukládá SQLite DB a nahrané/vygenerované obrázky (výchozí: ./storage).
# DATA_DIR=./storage

# Appka defaultně běží přes plain HTTP na LAN/Tailscale (viz docs/PRD.md sekce 4), takže session
# cookie NENÍ Secure. Pokud appku vystavíš za reverse proxy s TLS, nastav na "true".
# COOKIE_SECURE=true
